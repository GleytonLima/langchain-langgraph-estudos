# Copie para .env
AGENT_PORT=8102

# LM Studio (compatível com a API da OpenAI)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-coder-7b-instruct

# Postgres (checkpointer do LangGraph) - mesmo Postgres do docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chassi

# Langfuse (opcional; pegue as chaves em http://localhost:3000)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
