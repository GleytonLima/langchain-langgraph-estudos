# Copie para .env
CHASSI_PORT=8000

# LLM do roteador (mesmo LM Studio dos agentes)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-coder-7b-instruct

# Postgres - sessões do chassi
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chassi

# Registry de agentes
AGENTS_FILE=agents.yaml

# Timeout (segundos) aguardando resposta do agente — OpenAI + tools pode demorar
AGENT_TIMEOUT_SECONDS=300

# Langfuse (opcional) — traceia a chamada do roteador. Mesmas chaves do agente.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
